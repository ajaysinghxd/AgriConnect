MONGO_URI=mongodb://localhost:27017/agriconnect
PORT=5000
JWT_SECRET=your_jwt_secret_here

# Razorpay — use real Test Mode keys from https://dashboard.razorpay.com/app/keys
# Do NOT use placeholder values; Authentication will fail.
RAZORPAY_KEY_ID=rzp_test_PASTE_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PASTE_YOUR_SECRET_KEY_HERE

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
# Use gemini-2.5-flash (gemini-1.5-flash is auto-mapped if set)
GEMINI_MODEL=gemini-2.5-flash
